        <item>
            <title>1.2.6</title>
            <pubDate>Mon, 31 Aug 2026 14:53:31 -0500</pubDate>
            <sparkle:version>19</sparkle:version>
            <sparkle:shortVersionString>1.2.6</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
            <description><![CDATA[
                <ul>
                    <li>Fixed missing automality.com attribution on JPEG exports (the TIFF Software/Artist tags were silently dropped by ImageIO for that format; added a working carrier via EXIF).</li>
                    <li>New Location metadata control in Export settings: remove GPS entirely, reduce it to ~1km precision, or keep exact coordinates. Original/hidden metadata (camera info, AI-generation descriptions, embedded thumbnails) was already always removed -- this only affects GPS specifically.</li>
                    <li>New headless CLI (wf-metadata) for scripting the same watermark/resize/metadata-privacy pipeline without opening the app.</li>
                </ul>
            ]]></description>
            <enclosure url="https://github.com/cadavidf/WatermarkFactory/releases/download/v1.2.6/WatermarkFactory.dmg" length="2401870" type="application/octet-stream" sparkle:edSignature="ZubACjF1R7P/gHrEdrRfI0XiFYgdFOViLmptGsCxtR2PQZlkyXIN3BLeuSEBJg1p4sxpMHJ6RJGmNuLzgCcbDQ=="/>
        </item>
