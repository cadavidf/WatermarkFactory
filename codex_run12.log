+        .overlay(Rectangle().stroke(number == nil ? AutomalityColor.gray300 : AutomalityColor.ink, lineWidth: 2))
+        .onTapGesture { state.toggleOrder(for: item) }
+        .onDrag {
+            draggingItem = item
+            return NSItemProvider(object: item.url.path as NSString)
+        }
