    71	    static func outputFilename(for sourceURL: URL, settings: WatermarkSettings, order: Int? = nil, numberedCount: Int = 0) -> String {
    72	        let prefix = sanitize(settings.outputPrefix)
    73	        let sequence = order.map { String(format: "%0\(numberedCount >= 10 ? String(numberedCount).count : 1)d_", $0) } ?? ""
    74	        return "\(prefix)\(sequence)\(sourceURL.deletingPathExtension().lastPathComponent)\(sanitize(settings.outputSuffix)).\(resolvedFormat(sourceURL: sourceURL, format: settings.exportFormat).ext)"
    75	    }
    76	
    77	    static func uniqueOutputURL(for sourceURL: URL, outputFolder: URL, settings: WatermarkSettings, order: Int? = nil, numberedCount: Int = 0, usedURLs: inout Set<URL>) -> URL {
    78	        let filename = outputFilename(for: sourceURL, settings: settings, order: order, numberedCount: numberedCount)
    79	        let base = (filename as NSString).deletingPathExtension
    80	        let ext = (filename as NSString).pathExtension
    81	        var candidate = outputFolder.appendingPathComponent(filename)
    82	        var index = 2
    83	        while usedURLs.contains(candidate) {
    84	            candidate = outputFolder.appendingPathComponent("\(base) (\(index))").appendingPathExtension(ext)
    85	            index += 1
    86	        }
    87	        usedURLs.insert(candidate)
    88	        return candidate
    89	    }
