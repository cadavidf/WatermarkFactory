import SwiftUI

public enum AutomalityProgressStepState: Equatable, Sendable {
    case completed
    case current
    case future
}

public enum AutomalityProgressNavLogic {
    public static func normalizedCurrentIndex(_ currentIndex: Int, count: Int) -> Int? {
        guard count > 0 else { return nil }
        return min(max(currentIndex, 0), count - 1)
    }

    public static func state(for stepIndex: Int, currentIndex: Int, count: Int) -> AutomalityProgressStepState? {
        guard stepIndex >= 0, stepIndex < count,
              let currentIndex = normalizedCurrentIndex(currentIndex, count: count) else { return nil }
        if stepIndex < currentIndex { return .completed }
        if stepIndex == currentIndex { return .current }
        return .future
    }

    public static func select(_ index: Int, currentIndex: Int, count: Int, onSelect: (Int) -> Void) {
        guard let currentIndex = normalizedCurrentIndex(currentIndex, count: count),
              index >= 0, index <= currentIndex else { return }
        onSelect(index)
    }
}

public struct AutomalityProgressNav: View {
    private let steps: [String]
    @Binding private var currentStep: Int
    private let onSelect: (Int) -> Void

    public init(steps: [String], currentStep: Binding<Int>, onSelect: @escaping (Int) -> Void = { _ in }) {
        self.steps = steps
        self._currentStep = currentStep
        self.onSelect = onSelect
    }

    public init(steps: [String], currentStep: Int, onSelect: @escaping (Int) -> Void = { _ in }) {
        self.init(steps: steps, currentStep: .constant(currentStep), onSelect: onSelect)
    }

    public var body: some View {
        HStack(spacing: AutomalitySpacing.xs) {
            ForEach(steps.indices, id: \.self) { index in
                step(index)
                if index < steps.count - 1 {
                    Rectangle()
                        .fill(index < normalizedCurrentStep ? AutomalityColor.teal : AutomalityColor.gray300)
                        .frame(height: 2)
                }
            }
        }
    }

    private var normalizedCurrentStep: Int {
        AutomalityProgressNavLogic.normalizedCurrentIndex(currentStep, count: steps.count) ?? 0
    }

    private func step(_ index: Int) -> some View {
        let state = AutomalityProgressNavLogic.state(for: index, currentIndex: currentStep, count: steps.count) ?? .future
        return Button {
            AutomalityProgressNavLogic.select(index, currentIndex: currentStep, count: steps.count) { selected in
                currentStep = selected
                onSelect(selected)
            }
        } label: {
            VStack(spacing: AutomalitySpacing.xs) {
                ZStack {
                    Rectangle().fill(fill(for: state))
                    Rectangle().stroke(AutomalityColor.ink, lineWidth: 2)
                    if state == .completed {
                        PixelIcon(.check, tint: AutomalityColor.offWhite)
                            .padding(AutomalitySpacing.xs)
                    } else {
                        Text("\(index + 1)")
                            .font(AutomalityType.data())
                            .foregroundStyle(textColor(for: state))
                    }
                }
                .frame(width: AutomalitySpacing.lg, height: AutomalitySpacing.lg)

                Text(steps[index])
                    .automalityLabelText()
                    .foregroundStyle(state == .future ? AutomalityColor.gray500 : AutomalityColor.ink)
                    .lineLimit(1)
            }
        }
        .buttonStyle(.plain)
        .disabled(state == .future)
    }

    private func fill(for state: AutomalityProgressStepState) -> Color {
        switch state {
        case .completed: return AutomalityColor.tealDark
        case .current: return AutomalityColor.teal
        case .future: return AutomalityColor.gray100
        }
    }

    private func textColor(for state: AutomalityProgressStepState) -> Color {
        state == .future ? AutomalityColor.gray500 : AutomalityColor.offWhite
    }
}

