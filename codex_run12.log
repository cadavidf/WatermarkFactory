+        .onTapGesture { state.toggleOrder(for: item) }
+        .onDrag {
+            draggingItem = item
+            return NSItemProvider(object: item.url.path as NSString)
+        }
+        .onDrop(of: [UTType.text], delegate: ImageOrderDropDelegate(item: item, draggingItem: $draggingItem, state: state))
+    }
