 @MainActor
 final class AppState: ObservableObject {
+    enum Stage: Int, CaseIterable {
+        case selectImages, watermark, orderRename, export
+
+        var title: String {
+            switch self {
+            case .selectImages: "Select Images"
+            case .watermark: "Watermark"
+            case .orderRename: "Order & Rename"
+            case .export: "Export"
+            }
+        }
