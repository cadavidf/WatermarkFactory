import SwiftUI

public struct AutomalityButtonStyle: ButtonStyle {
    public enum Variant {
        case primary
        case secondary
    }

    private let variant: Variant

    public init(_ variant: Variant = .primary) {
        self.variant = variant
    }

    public func makeBody(configuration: Configuration) -> some View {
        configuration.label
            .automalityLabelText()
            .foregroundStyle(foreground)
            .padding(.horizontal, AutomalitySpacing.sm)
            .padding(.vertical, AutomalitySpacing.xs)
            .background(fill)
            .overlay(Rectangle().stroke(border, lineWidth: 2))
            .overlay(configuration.isPressed ? Color.white.opacity(0.22) : Color.clear)
            .offset(x: configuration.isPressed ? AutomalitySpacing.hardShadow : 0,
                    y: configuration.isPressed ? AutomalitySpacing.hardShadow : 0)
            .background(
                Rectangle()
                    .fill(shadow)
                    .offset(x: AutomalitySpacing.hardShadow, y: AutomalitySpacing.hardShadow)
                    .opacity(configuration.isPressed ? 0 : 1)
            )
            .animation(.linear(duration: 0.07), value: configuration.isPressed)
    }

    private var fill: Color {
        variant == .primary ? AutomalityColor.teal : AutomalityColor.offWhite
    }

    private var foreground: Color {
        variant == .primary ? AutomalityColor.offWhite : AutomalityColor.ink
    }

    private var border: Color {
        variant == .primary ? AutomalityColor.tealDeep : AutomalityColor.ink
    }

    private var shadow: Color {
        variant == .primary ? AutomalityColor.tealDeep : AutomalityColor.ink
    }
}

public extension ButtonStyle where Self == AutomalityButtonStyle {
    static var automalityPrimary: AutomalityButtonStyle { .init(.primary) }
    static var automalitySecondary: AutomalityButtonStyle { .init(.secondary) }
}

