+    private static func scrubbedMetadata(sourceURL: URL) -> [CFString: Any] {
+        var properties: [CFString: Any] = [
+            kCGImagePropertyTIFFDictionary: [kCGImagePropertyTIFFSoftware: "automality.com"],
+            kCGImagePropertyIPTCDictionary: [kCGImagePropertyIPTCByline: "automality.com"]
+        ]
+        guard let source = CGImageSourceCreateWithURL(sourceURL as CFURL, nil),
+              let sourceProperties = CGImageSourceCopyPropertiesAtIndex(source, 0, nil) as? [CFString: Any],
+              let gps = sourceProperties[kCGImagePropertyGPSDictionary] else {
+            return properties
+        }
+        properties[kCGImagePropertyGPSDictionary] = gps
+        return properties
+    }
+
