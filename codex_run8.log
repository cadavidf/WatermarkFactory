+        var data = try Data(contentsOf: url)
+        let app1 = Data([0xFF, 0xE1, 0x00, 0x0D]) + Data("Exif\0\0badexif".utf8)
+        data.insert(contentsOf: app1, at: jpegMetadataInsertionIndex(in: data))
+        try data.write(to: url)
