            selected = images.first
            status = images.isEmpty ? "No supported images found in this folder." : "\(images.count) images found."
            saveImageBookmarks()
            updateEstimate()
        } catch {
            images = []
            selected = nil
            status = "Couldn't access the selected folder. Please re-choose it."
        }
    }

