import SwiftUI

public enum AutomalitySliderMath {
    public static func clamped(_ value: Double, in range: ClosedRange<Double>) -> Double {
        min(max(value, range.lowerBound), range.upperBound)
    }

    public static func position(for value: Double, in range: ClosedRange<Double>, width: CGFloat) -> CGFloat {
        guard width > 0, range.lowerBound != range.upperBound else { return 0 }
        let fraction = (clamped(value, in: range) - range.lowerBound) / (range.upperBound - range.lowerBound)
        return CGFloat(fraction) * width
    }

    public static func value(at position: CGFloat, in range: ClosedRange<Double>, width: CGFloat) -> Double {
        guard width > 0, range.lowerBound != range.upperBound else { return range.lowerBound }
        let fraction = Double(min(max(position / width, 0), 1))
        return range.lowerBound + fraction * (range.upperBound - range.lowerBound)
    }
}

public struct AutomalitySlider: View {
    @Binding private var value: Double
    private let range: ClosedRange<Double>

    public init(value: Binding<Double>, in range: ClosedRange<Double>) {
        self._value = value
        self.range = range
    }

    public var body: some View {
        GeometryReader { proxy in
            let width = proxy.size.width
            let fillWidth = AutomalitySliderMath.position(for: value, in: range, width: width)

            ZStack(alignment: .leading) {
                Rectangle()
                    .fill(AutomalityColor.gray100)
                Rectangle()
                    .fill(AutomalityColor.teal)
                    .frame(width: fillWidth)
                Rectangle()
                    .stroke(AutomalityColor.ink, lineWidth: 2)
                Rectangle()
                    .fill(AutomalityColor.ink)
                    .frame(width: AutomalitySpacing.sm, height: AutomalitySpacing.sm)
                    .offset(x: min(max(fillWidth - AutomalitySpacing.xs, 0), max(width - AutomalitySpacing.sm, 0)))
            }
            .contentShape(Rectangle())
            .gesture(
                DragGesture(minimumDistance: 0)
                    .onChanged { drag in
                        value = AutomalitySliderMath.value(at: drag.location.x, in: range, width: width)
                    }
            )
        }
        .frame(height: AutomalitySpacing.md)
    }
}
