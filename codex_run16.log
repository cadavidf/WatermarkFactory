public struct AutomalitySegmentedControl<Option: Identifiable & Hashable>: View {
    private let options: [Option]
    @Binding private var selection: Option
    private let label: (Option) -> String
    private let icon: ((Option) -> AnyView)?

    public init(
        options: [Option],
        selection: Binding<Option>,
        label: @escaping (Option) -> String,
        icon: ((Option) -> AnyView)? = nil
