+        }
+        let rect = CGRect(x: 0, y: 0, width: image.width, height: image.height)
+        context.clip(to: rect, mask: image)
+        context.setFillColor(color)
+        context.fill(rect)
+        guard let tinted = context.makeImage() else { throw ImageProcessorError.contextFailed }
+        return tinted
