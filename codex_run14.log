+    private static func saliencyRect(in image: CGImage) -> CGRect? {
+        let request = VNGenerateAttentionBasedSaliencyImageRequest()
+        let handler = VNImageRequestHandler(cgImage: image)
+        do {
+            try handler.perform([request])
