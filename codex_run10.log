   750	    private func displayedWatermarkRect(in size: CGSize) -> CGRect? {
   751	        guard state.layoutMode == .single,
   752	              let sourceSize = state.sourceImageSize,
   753	              let watermarkSize = state.watermarkImageSize else { return nil }
   754	        let scale = displayScale(in: size)
   755	        guard scale > 0 else { return nil }
   756	        let imageSize = CGSize(width: sourceSize.width * scale, height: sourceSize.height * scale)
   757	        let origin = CGPoint(x: (size.width - imageSize.width) / 2, y: (size.height - imageSize.height) / 2)
   758	        let frame = ImageProcessor.watermarkFrame(sourceSize: sourceSize, watermarkSize: watermarkSize, settings: state.settings)
   759	        return CGRect(
   760	            x: origin.x + frame.minX * scale,
   761	            y: origin.y + (sourceSize.height - frame.maxY) * scale,
   762	            width: frame.width * scale,
   763	            height: frame.height * scale
   764	        )
   765	    }
   766	
   767	    private func displayScale(in size: CGSize) -> CGFloat {
   768	        guard let sourceSize = state.sourceImageSize, sourceSize.width > 0, sourceSize.height > 0 else { return 0 }
   769	        let available = CGSize(width: max(0, size.width - padding * 2), height: max(0, size.height - padding * 2))
   770	        return min(available.width / sourceSize.width, available.height / sourceSize.height)
   771	    }
   772	}
