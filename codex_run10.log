   726	                                .stroke(Color.accentColor.opacity(dragStart == nil ? 0.25 : 0.8), lineWidth: dragStart == nil ? 1 : 2)
   727	                        )
   728	                        .frame(width: rect.width, height: rect.height)
   729	                        .position(x: rect.midX, y: rect.midY)
   730	                        .contentShape(Rectangle())
   731	                        .onHover { hovering in (hovering ? NSCursor.openHand : NSCursor.arrow).set() }
   732	                        .gesture(
   733	                            DragGesture(minimumDistance: 0)
   734	                                .onChanged { value in
   735	                                    let start = dragStart ?? CGPoint(x: state.offsetX, y: state.offsetY)
