   737	                                    NSCursor.closedHand.set()
   738	                                    state.dragWatermark(startX: Double(start.x), startY: Double(start.y), delta: value.translation, displayScale: displayScale(in: proxy.size))
   739	                                }
   740	                                .onEnded { _ in
   741	                                    dragStart = nil
   742	                                    NSCursor.openHand.set()
   743	                                }
   744	                        )
   745	                }
   746	            }
   747	        }
   748	    }
